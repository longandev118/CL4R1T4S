.orders {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 状态切换 */
.status-tabs {
  display: flex;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 5;
}
.status-tab {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}
.status-tab.active {
  color: #e4393c;
  font-weight: bold;
}
.status-tab.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #e4393c;
  border-radius: 6rpx;
}

/* 空态 */
.empty {
  text-align: center;
  color: #999;
  padding-top: 200rpx;
  font-size: 28rpx;
}
.go-buy {
  color: #e4393c;
  margin-top: 20rpx;
}

/* 订单卡片 */
.order-card {
  background: #fff;
  margin: 16rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}
.order-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f2f2f2;
}
.order-no {
  color: #999;
  font-size: 24rpx;
}
.order-status {
  color: #e4393c;
  font-size: 26rpx;
}
.order-goods {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}
.g-img {
  width: 100rpx;
  height: 100rpx;
  background: #f0f0f0;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #bbb;
  flex-shrink: 0;
}
.g-info {
  flex: 1;
  margin-left: 20rpx;
}
.g-name {
  font-size: 26rpx;
}
.g-spec {
  color: #999;
  font-size: 22rpx;
  margin-top: 8rpx;
}
.g-right {
  text-align: right;
}
.g-price {
  font-size: 26rpx;
}
.g-count {
  color: #999;
  font-size: 24rpx;
  margin-top: 8rpx;
}
.order-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f2f2f2;
  font-size: 24rpx;
  color: #999;
}
.price {
  color: #e4393c;
  font-weight: bold;
  font-size: 30rpx;
}
