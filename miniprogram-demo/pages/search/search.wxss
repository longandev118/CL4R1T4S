.search {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 16rpx 24rpx;
}
.input-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f2f2f2;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
}
.s-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}
.s-input {
  flex: 1;
  font-size: 28rpx;
}
.s-btn {
  color: #e4393c;
  font-size: 30rpx;
  margin-left: 20rpx;
}

/* 热门搜索 */
.hot {
  padding: 32rpx 24rpx;
}
.hot-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}
.hot-words {
  display: flex;
  flex-wrap: wrap;
}
.hot-word {
  background: #fff;
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #333;
  margin: 0 16rpx 16rpx 0;
}

/* 结果 */
.empty {
  text-align: center;
  color: #999;
  padding-top: 160rpx;
  font-size: 28rpx;
}
.result-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 16rpx;
}
.r-img {
  width: 140rpx;
  height: 140rpx;
  background: #f0f0f0;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #bbb;
  flex-shrink: 0;
}
.r-info {
  flex: 1;
  margin-left: 20rpx;
}
.r-name {
  font-size: 28rpx;
}
.r-tag {
  background: #e4393c;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
}
.r-desc {
  color: #999;
  font-size: 24rpx;
  margin: 10rpx 0;
}
.price {
  color: #e4393c;
  font-weight: bold;
  font-size: 34rpx;
}
