.cart-page {
  padding: 16rpx 16rpx 120rpx;
}
.empty {
  text-align: center;
  color: #999;
  margin-top: 200rpx;
  font-size: 28rpx;
}
.cart-item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.c-img {
  width: 140rpx;
  height: 140rpx;
  background: #f0f0f0;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #bbb;
  flex-shrink: 0;
}
.c-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}
.c-name {
  font-size: 28rpx;
}
.c-spec {
  color: #999;
  font-size: 24rpx;
  margin: 8rpx 0;
}
.c-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
}
.price {
  color: #e4393c;
  font-weight: bold;
  font-size: 34rpx;
}
.stepper {
  display: flex;
  align-items: center;
}
.step-btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  text-align: center;
  border: 1rpx solid #ddd;
  border-radius: 50%;
  font-size: 34rpx;
  color: #666;
}
.step-num {
  margin: 0 24rpx;
  font-size: 30rpx;
}
.cart-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}
.cart-total {
  flex: 1;
  font-size: 28rpx;
}
.checkout-btn {
  padding: 18rpx 60rpx;
  font-size: 30rpx;
}
