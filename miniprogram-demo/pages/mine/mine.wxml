<view class="mine">

  <!-- 用户信息头部 -->
  <view class="header">
    <block wx:if="{{userInfo}}">
      <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
      <view class="user-text">
        <view class="nick">{{userInfo.nickName}}</view>
        <view class="openid">ID: {{userInfo.openid}}</view>
      </view>
    </block>
    <block wx:else>
      <view class="avatar placeholder">头像</view>
      <view class="user-text">
        <view class="btn-login" bindtap="onLogin">微信登录 ›</view>
      </view>
    </block>
  </view>

  <!-- 我的订单入口 -->
  <view class="card">
    <view class="card-head">
      <text class="card-title">我的订单</text>
      <text class="card-more" data-status="all" bindtap="goOrders">查看全部 ›</text>
    </view>
    <view class="order-nav">
      <view class="order-nav-item" data-status="unpaid" bindtap="goOrders">
        <view class="icon">💰</view><text>待付款</text>
      </view>
      <view class="order-nav-item" data-status="pending" bindtap="goOrders">
        <view class="icon">📦</view><text>待收货</text>
      </view>
      <view class="order-nav-item" data-status="done" bindtap="goOrders">
        <view class="icon">✅</view><text>已完成</text>
      </view>
      <view class="order-nav-item" data-status="all" bindtap="goOrders">
        <view class="icon">🧾</view><text>全部订单</text>
      </view>
    </view>
  </view>

  <!-- 常用功能 -->
  <view class="menu">
    <view class="menu-item" bindtap="goCart"><text>🛒 购物车</text><text class="arrow">›</text></view>
    <view class="menu-item"><text>📍 收货地址</text><text class="arrow">›</text></view>
    <view class="menu-item"><text>🎫 我的优惠券</text><text class="arrow">›</text></view>
    <view class="menu-item"><text>☎️ 联系客服</text><text class="arrow">›</text></view>
  </view>

  <view wx:if="{{userInfo}}" class="logout" bindtap="onLogout">退出登录</view>

</view>
