.detail {
  padding-bottom: 120rpx;
}

/* 轮播 */
.banner {
  height: 560rpx;
}
.banner-img {
  height: 560rpx;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #bbb;
  font-size: 48rpx;
}

/* 价格标题 */
.head {
  background: #fff;
  padding: 28rpx;
}
.price-row {
  display: flex;
  align-items: baseline;
}
.price {
  color: #e4393c;
  font-weight: bold;
  font-size: 56rpx;
}
.rmb {
  font-size: 28rpx;
}
.from {
  color: #999;
  font-size: 24rpx;
  margin-left: 8rpx;
}
.title {
  font-size: 34rpx;
  font-weight: bold;
  margin: 16rpx 0 8rpx;
}
.sub {
  color: #999;
  font-size: 26rpx;
}

/* 选规格入口 */
.row {
  background: #fff;
  margin-top: 16rpx;
  padding: 28rpx;
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
}
.arrow {
  color: #999;
}

/* 图文详情 */
.section-title {
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  font-weight: bold;
}
.detail-img {
  height: 400rpx;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #bbb;
  font-size: 40rpx;
  margin-bottom: 2rpx;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}
.act-icon {
  font-size: 44rpx;
  position: relative;
  margin-right: 24rpx;
}
.badge {
  position: absolute;
  top: -8rpx;
  right: -12rpx;
  background: #e4393c;
  color: #fff;
  font-size: 20rpx;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
  border-radius: 999rpx;
  padding: 0 6rpx;
}
.act-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  color: #fff;
  font-size: 30rpx;
}
.act-btn.add {
  background: #ff9500;
  border-radius: 999rpx 0 0 999rpx;
}
.act-btn.buy {
  background: #e4393c;
  border-radius: 0 999rpx 999rpx 0;
}

/* 规格弹层 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 10;
}
.spec-popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx;
  z-index: 11;
  transform: translateY(100%);
  transition: transform 0.25s;
}
.spec-popup.show {
  transform: translateY(0);
}
.spec-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.spec-title {
  font-size: 32rpx;
  font-weight: bold;
}
.spec-close {
  font-size: 44rpx;
  color: #999;
  line-height: 1;
}
.spec-list {
  display: flex;
  flex-wrap: wrap;
  margin: 24rpx 0;
}
.spec-item {
  padding: 14rpx 28rpx;
  border: 1rpx solid #ddd;
  border-radius: 999rpx;
  margin: 0 16rpx 16rpx 0;
  font-size: 26rpx;
  color: #333;
}
.spec-item.active {
  border-color: #e4393c;
  color: #e4393c;
  background: #fff5f5;
}
.qty-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0 28rpx;
  font-size: 28rpx;
}
.stepper {
  display: flex;
  align-items: center;
}
.step-btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  text-align: center;
  border: 1rpx solid #ddd;
  border-radius: 50%;
  font-size: 34rpx;
  color: #666;
}
.step-num {
  margin: 0 24rpx;
  font-size: 30rpx;
}
.confirm-btn {
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 32rpx;
}
